{
  "name": "smartbilling",
  "version": "0.1.0",
  "private": true,
  "description": "Lingkungan pengembangan Capstone A05",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
