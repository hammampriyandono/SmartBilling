    "smoke": "node scripts/smoke.js",
    "verify:persistence": "node scripts/smoke.js --verify-persistence"
  },
  "dependencies": {
    "express": "5.2.1",
    "mqtt": "5.15.2",
    "pg": "8.23.0"
  }
}
