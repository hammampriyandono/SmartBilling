RAILWAY_DOCKERFILE_PATH=Dockerfile.mqtt
MQTT_BACKEND_USERNAME=splitzbill-backend
MQTT_BACKEND_PASSWORD=<GENERATE_64_HEX_CHARACTERS>
# MQTT_DEVICE_CREDENTIALS adalah satu variable multiline. Format setiap baris:
# <REGISTERED_DEVICE_UID>|sensor|<UNIQUE_64_HEX_CHARACTER_PASSWORD>
# <REGISTERED_DEVICE_UID>|rfid|<UNIQUE_64_HEX_CHARACTER_PASSWORD>
# <REGISTERED_DEVICE_UID>|combined|<UNIQUE_64_HEX_CHARACTER_PASSWORD>
# Boleh kosong saat menyiapkan cloud tanpa ESP.
MQTT_DEVICE_CREDENTIALS=
# Public TLS listener 8883 baru aktif jika KEDUANYA tersedia (PEM multiline).
# MQTT_TLS_CERT=<CERTIFICATE_CHAIN_FOR_ACTUAL_MQTT_HOSTNAME>
# MQTT_TLS_KEY=<PRIVATE_KEY_FOR_CERTIFICATE>
# Jaringan privat backend memakai 1883; jangan publikasikan 1883 melalui TCP Proxy.
