# Isi melalui Variables Railway, bukan berkas .env yang di-commit.
APP_ENV=production
RAILWAY_DOCKERFILE_PATH=Dockerfile
NODE_ENV=production
DATA_MODE=operational
VITE_DATA_MODE=operational
BIND_HOST=0.0.0.0
TRUST_PROXY_HOPS=1
DATABASE_URL=${{Postgres.DATABASE_URL}}
MQTT_URL=mqtt://${{MQTT.RAILWAY_PRIVATE_DOMAIN}}:1883
MQTT_USERNAME=${{MQTT.MQTT_BACKEND_USERNAME}}
MQTT_PASSWORD=${{MQTT.MQTT_BACKEND_PASSWORD}}
MQTT_CLIENT_ID=splitzbill-backend-v1
SESSION_SECRET=<GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
SESSION_COOKIE_NAME=splitzbill.sid
AUTH_ORIGIN=https://<ACTUAL_BACKEND_PUBLIC_DOMAIN>
ROOM_RELAY_CONTROL_ENABLED=false
# PORT disediakan Railway. Jangan arahkan URL database ke DATABASE_PUBLIC_URL.
