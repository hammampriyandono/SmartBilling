# Contoh konfigurasi lokal; npm run init:local membuat .env tanpa menimpa berkas lama.
BACKEND_PORT=3000
MONITORING_MAX_GAP_SECONDS=120
# Secret dibaca melalui Compose secrets, bukan dimasukkan ke image atau Git.
# .local/secrets/postgres_password: <GENERATE_LOCAL_RANDOM_PASSWORD>
# .local/secrets/mqtt_password: <GENERATE_LOCAL_RANDOM_PASSWORD>
# Jalankan npm run init:local untuk menghasilkan kedua berkas tersebut.
